# Ambiente da aplicação.
# Valores aceitos para habilitar a página /testes: test, teste, development, desenvolvimento ou dev.
# Em produção, deixe como production ou vazio para manter /testes indisponível.
ENV=production

# Ambiente do Node.js/Next.js. Normalmente é definido automaticamente pelos scripts do Next.js.
NODE_ENV=development

# URL pública do frontend usada na geração de links enviados por e-mail.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pública da API consumida pelo frontend.
NEXT_PUBLIC_API_URL=http://localhost:3333

# URL da API para uso server-side quando NEXT_PUBLIC_API_URL não estiver definida.
API_URL=http://localhost:3333

# Configurações SMTP para envio de e-mails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
